# Copy this file to backend/.env (gitignored) and fill in your own values.

# Supabase Postgres connection string. Use the "Transaction pooler" string
# (port 6543) from Project Settings -> Database -> Connection string in the
# Supabase dashboard - it's the one safe to use from many short-lived
# connections (serverless functions, one-off scripts), unlike the direct
# connection (port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
