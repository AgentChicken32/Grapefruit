# Copy to frontend/.env.local (gitignored by Vite's default .gitignore) for
# local overrides. In Vercel, set VITE_API_BASE as a Project env var instead.

# Leave unset for local dev (falls back to http://localhost:8000/api).
# In Vercel: set to "/api" -- the frontend and backend are two services in
# the same project (see vercel.json), routed to the same domain, so the API
# is same-origin. No absolute URL needed, and no CORS involved in prod.
# VITE_API_BASE=/api
